# MONGODB_URI: Optional MongoDB connection string for persistent RAVI FANCY STORE catalog & orders.
# Example: mongodb+srv://<user>:<password>@cluster.mongodb.net/ravi_fancy_store
# When omitted, the server persists data locally in data/ravi-fancy-store.json.
MONGODB_URI=""

# ADMIN_PASSWORD: Password for the RAVI FANCY STORE Admin Dashboard.
ADMIN_PASSWORD="ravi-admin-2026"

# SESSION_SECRET: Secret key used to sign admin session cookies & bearer tokens.
SESSION_SECRET="ravi-fancy-store-dev-session-secret"

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Optional Razorpay Test Mode API credentials.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# PORT: Server port (default: 3000)
PORT="3000"
