# GEMINI_API_KEY: Required for server-side Gemini AI product recommendations & smart pantry search.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB connection string for persistent supermarket catalog, users & orders.
# Example: mongodb+srv://<user>:<password>@cluster.mongodb.net/ravi_supermarket
# When omitted, the server persists data locally in data/ravi-supermarket.json.
MONGODB_URI=""

# ADMIN_PASSWORD: Password for the RAVI SUPERMARKET Admin Dashboard.
ADMIN_PASSWORD="MY_ADMIN_PASSWORD"

# SESSION_SECRET: Secret key used to sign customer and admin session tokens.
SESSION_SECRET="MY_SESSION_SECRET"

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Optional Razorpay Test Mode API credentials.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# CLOUDINARY_URL: Optional media storage URL for product imagery.
CLOUDINARY_URL=""

# SMTP_URL: Optional SMTP connection string for order confirmation & invoice emails.
SMTP_URL=""
